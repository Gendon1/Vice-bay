{
  "$schema": "https://opencode.ai/config.json",
  "model": "coarena/gpt-6-luna",
  "provider": {
    "coarena": {
      "models": {
        "gpt-6-luna": {
          "name": "GPT-6 Luna (free)",
          "limit": {
            "context": 128000,
            "output": 16384
          }
        },
        "gemini-3-8-flash": {
          "name": "Gemini 3.8 Flash (free)",
          "limit": {
            "context": 128000,
            "output": 16384
          }
        },
        "deepseek-v4-1-flash-1017": {
          "name": "DeepSeek V4.1 Flash (free, may substitute to GPT-6 Luna)",
          "limit": {
            "context": 128000,
            "output": 16384
          }
        }
      },
      "name": "Coarena",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "{env:COARENA_API_KEY}",
        "baseURL": "https://coarena.ai/api/v1"
      }
    }
  }
}